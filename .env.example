# Copy this to .env and fill in real values.
# .env is git-ignored; this .env.example is safe to commit.

# PostgreSQL connection string (required)
DATABASE_URL=postgres://localhost:5432/tracker

# Optional — set to require a login password. Unset = no auth (local dev).
# APP_PASSWORD=

# Optional — analysis service URL (defaults to http://localhost:8100)
# ANALYSIS_URL=http://localhost:8100
